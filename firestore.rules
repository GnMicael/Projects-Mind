rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function small() { return request.resource.data.keys().size() <= 60; }

    // Perfil: só o próprio usuário, só campos conhecidos, nunca apagar.
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && small()
        && request.resource.data.keys().hasOnly(['name','email','professions','purposes','style','wants','level','onboardingCompleted','createdAt','updatedAt','prefs']);
      allow delete: if false;
    }

    // Dados do usuário: modelo único de propriedade (ownerId).
    // O dono não pode ser trocado em atualizações.
    match /{coll}/{id} {
      allow read, delete: if signedIn()
        && coll in ['projects','tasks','events','notes','stakeholders','risks','goals','milestones','ideas']
        && resource.data.ownerId == request.auth.uid;
      allow create: if signedIn()
        && coll in ['projects','tasks','events','notes','stakeholders','risks','goals','milestones','ideas']
        && request.resource.data.ownerId == request.auth.uid && small();
      allow update: if signedIn()
        && coll in ['projects','tasks','events','notes','stakeholders','risks','goals','milestones','ideas']
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == request.auth.uid && small();
    }

    // Feedback: só criação, com limites de tamanho; ninguém lê pelo app.
    match /feedback/{id} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.category in ['bug','melhoria','recurso']
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 120
        && request.resource.data.description is string && request.resource.data.description.size() <= 2000;
      allow read, update, delete: if false;
    }
  }
}
